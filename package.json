{
  "name": "faqih-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run clean:dev && npm run index:hadith",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "clean:dev": "node scripts/clean-next-cache.mjs",
    "index:hadith": "node scripts/build-local-hadith-index.mjs",
    "test:retrieval": "node scripts/smoke-local-retrieval.mjs --assert",
    "test:behavior": "node scripts/test-local-behavior.mjs",
    "prebuild": "npm run index:hadith",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts/*.mjs public/*.mjs public/hadith-search.worker.js"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "fs-extra": "^11.3.0",
    "lucide-react": "^0.475.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "@types/node": "22.13.5",
    "@types/react": "19.2.17"
  },
  "archaicDependencies": {
    "note": "archaic: retained only as a record of the retired OpenAI ingestion path",
    "@dqbd/tiktoken": "^1.0.20",
    "js-tiktoken": "^1.0.19",
    "openai": "^4.95.1"
  },
  "overrides": {
    "@types/react": "19.2.17"
  }
}
